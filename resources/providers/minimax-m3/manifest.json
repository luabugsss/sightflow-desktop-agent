{
  "apiVersion": 1,
  "id": "minimax-m3",
  "name": "MiniMax",
  "version": "1.0.0",
  "entry": "provider.bundle.js",
  "moduleType": "module",
  "capabilities": ["chat"],
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "password",
        "title": "API Key"
      },
      "model": {
        "type": "string",
        "title": "Model",
        "default": "MiniMax-M3"
      },
      "baseURL": {
        "type": "string",
        "title": "Base URL",
        "default": "https://token-plan-cn.xiaomimimo.com/v1"
      },
      "thinking": {
        "type": "select",
        "title": "Thinking",
        "default": "adaptive",
        "enum": ["adaptive", "disabled"]
      },
      "systemPrompt": {
        "type": "string",
        "title": "System Prompt",
        "default": ""
      }
    },
    "required": ["apiKey"]
  }
}
